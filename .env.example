DATABASE_URL=postgres://nusavela:local-dev-only@localhost:5432/nusavela
DATABASE_MAX_CONNECTIONS=10
BIND_ADDR=0.0.0.0:8080
CORS_ORIGINS=http://localhost:3000
# Generate a random secret of at least 32 bytes. Unset disables admin routes.
ADMIN_JWT_SECRET=
ADMIN_JWT_ISSUER=nusavela-admin
ADMIN_JWT_AUDIENCE=nusavela-api
OPENWEATHER_API_KEY=
RSS_ENABLED=false
RUST_LOG=nusavela_backend=info,tower_http=info

# Operator CLI only. Mint a short-lived JWT with mint_admin_token.
# Never expose these through VITE_* or commit actual values.
ADMIN_API_URL=http://localhost:8080
ADMIN_API_TOKEN=
# Full official affiliate tracking URLs; applied per place by scripts/admin.mjs.
AFFILIATE_HOTEL_URL=
AFFILIATE_TICKET_URL=
